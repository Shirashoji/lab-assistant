# MCP サーバー固有の設定。
# esa / Discord / Google の認証は親ディレクトリ (../) の calendar-agent の .env を読みます。
# ホスティング環境では下記に加えて、その .env のキー
#   DISCORD_BOT_TOKEN / ESA_ACCESS_TOKEN / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   GOOGLE_REFRESH_TOKEN / GOOGLE_CALENDAR_ID / TIMEZONE
# を環境変数として設定してください (環境変数が .env より優先されます)。

# HTTP 版の待受ポート
PORT=8787

# 設定するとすべての /mcp リクエストに Authorization: Bearer <この値> を要求します。
# ChatGPT の「認証なし」コネクタで使う場合は空のままにし、代わりに推測困難な
# トンネル URL で保護してください (CHATGPT.md 参照)。
MCP_AUTH_TOKEN=
