# ─────────────────────────────────────────────────────────────
# lab-assistant 設定ファイル
# このファイルを `.env` にコピーして値を埋めてください。
# `.env` は .gitignore 済みです。コミットしないでください。
# ─────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────
# Discord Developer Portal で作成した Bot のトークン。
# Bot は対象メッセージのあるサーバーに参加し、
# 「チャンネルを見る」「メッセージ履歴を読む」権限が必要です。
# また Portal の Bot 設定で MESSAGE CONTENT INTENT を ON にしてください。
DISCORD_BOT_TOKEN=

# ── esa ──────────────────────────────────────────────────────
# https://<team>.esa.io/user/applications で発行する Personal Access Token (PAT v2 推奨)。
# 記事の閲覧/検索だけなら read 系スコープで可。この値は:
#   - add-event フロー(URL → 記事取得)で raw REST が使う
#   - esa 公式 MCP (.mcp.json の plugin:lab-assistant:esa) の起動時に渡される
ESA_ACCESS_TOKEN=
# 省略可。URL からチーム名が取れない場合の add-event フローのフォールバック。
ESA_DEFAULT_TEAM=

# ── Slack (任意 / 学科ワークスペースの検索用) ────────────────
# ワークスペース検索 (search.messages) は「ユーザートークン」限定。Bot トークン不可。
# 手順:
#   1. slack-app/ の manifest を自分のワークスペースにインストール
#        cd slack-app && slack app install --team <TEAM_ID>
#   2. https://api.slack.com/apps/<APP_ID>/oauth で "User OAuth Token" (xoxp-) をコピー
#      (必要 user スコープ: search:read / users:read / channels:read / groups:read)
SLACK_USER_TOKEN=

# ── Google Calendar ──────────────────────────────────────────
# Google Cloud Console で作成した OAuth クライアント (種類: デスクトップ)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# `node scripts/bin/auth-google.mjs` を実行して取得した値を貼り付け
GOOGLE_REFRESH_TOKEN=

# 予定を追加するカレンダー ID (既定: primary = OAuth に使ったアカウントの個人カレンダー)
# 研究室など共有カレンダーに入れたい場合:
#   1. そのカレンダーを OAuth に使った Google アカウントに「予定の変更権限」で共有
#   2. `node scripts/bin/list-calendars.mjs` で ID を確認 (例: xxxx@group.calendar.google.com)
#   3. その ID を下に設定
GOOGLE_CALENDAR_ID=primary

# ── 横断検索 (node scripts/bin/search.mjs) ───────────────────
# Discord 横断検索の対象サーバー(ギルド)ID。カンマ区切り。
# 未設定なら Bot が参加している全ギルドを対象にします。
DISCORD_GUILD_IDS=
# 省略可。検索対象を特定チャンネルに絞る場合のみ、チャンネル ID をカンマ区切りで。
DISCORD_SEARCH_CHANNEL_IDS=
# 省略可。1 チャンネルあたり遡って取得するページ数 (100 件/ページ、既定 3)。
SEARCH_MAX_PAGES_PER_CHANNEL=3

# ── その他 ───────────────────────────────────────────────────
# 予定の日時解釈に使うタイムゾーン
TIMEZONE=Asia/Tokyo
# auth-google.mjs が使うループバックポート
OAUTH_REDIRECT_PORT=4779

# ── Slack ────────────────────────────────────────────────────
# 自前アプリ lab-assistant-search の User OAuth Token (xoxp-)
SLACK_USER_TOKEN=xoxp-

# ── Google Drive (Phase 4) ───────────────────────────────────
# Drive 検索は Calendar と同じ OAuth 認証情報を使う。
# drive.readonly スコープを足したので `node scripts/bin/auth-google.mjs` の再実行が必要。
# 検索対象を絞るフォルダ ID (カンマ区切り、未設定ならアクセスできる全ファイル)
DRIVE_FOLDER_IDS=
# 検索対象の MIME タイプ (カンマ区切り、未設定なら全種別)
DRIVE_MIME_TYPES=
