# ── Discord ──────────────────────────────────────────────────
# lab-assistant プラグインの .env と同じ Bot Token でよい
DISCORD_BOT_TOKEN=

# 応答を許可するサーバー(ギルド)ID。カンマ区切り。空なら全ギルドで応答する。
ALLOWED_GUILD_IDS=

# ── Claude ───────────────────────────────────────────────────
# Anthropic API キー (Claude Code のサブスク認証を使う場合は claude login 済みなら不要なこともある)
ANTHROPIC_API_KEY=

# ── プラグイン ───────────────────────────────────────────────
# lab-assistant プラグインの絶対パス (この bot/ の 1 つ上の階層)
# 例: /Users/takuma/develop/vdslab/Agent-Plugins/lab-assistant
PLUGIN_ROOT=
